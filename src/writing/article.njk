---
layout: base
pagination:
  data: writing
  size: 1
  alias: post
eleventyComputed:
  title: "{{ post.title }} — Qusai Ismael"
  description: "{{ post.excerpt }}"
  permalink: "/writing/{{ post.slug }}/"
ogType: article
---
<main class="container reading-width" id="main-content">
  <header class="page-heading"><a class="text-link" href="/blog/">← All writing</a><p class="eyebrow"><time datetime="{{ post.date }}">{{ post.dateLabel }}</time> · Qusai Ismael</p><h1>{{ post.title }}</h1><p class="muted">Originally published on <a href="{{ post.url }}" rel="noopener noreferrer">Medium ↗</a>. Archived here so you can read it without leaving.</p></header>
  <article class="article-body" aria-label="Article">{{ post.body | safe }}</article>
  <section><h2>Want to talk about it?</h2><p>I'm always up for a good question, or a different way of looking at something.</p><a class="text-link" href="mailto:{{ site.email }}">Send me a note ↗</a></section>
</main>
