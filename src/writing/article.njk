---
layout: base
pagination:
  data: writing
  size: 1
  alias: post
eleventyComputed:
  title: "{{ post.title }} — Qusai Ismael"
  description: "{{ post.excerpt }}"
  permalink: "/writing/{{ post.slug }}/"
ogType: article
---
<main class="container" id="main-content">
  {% set article = post.body | articleOutline %}
  <header class="page-heading reading-width">
    <a class="text-link" href="/blog/">← All writing</a>
    <p class="eyebrow"><time datetime="{{ post.date }}">{{ post.dateLabel }}</time> · Qusai Ismael</p>
    <h1>{{ post.title }}</h1>
    <p class="article-summary page-lede">{{ post.excerpt }}</p>
    <p class="article-meta">Originally published on <a href="{{ post.url }}" rel="noopener noreferrer">Medium ↗</a>.</p>
  </header>
  <div class="article-layout{% if article.items.length >= 3 %} has-outline{% endif %}">
    {% if article.items.length >= 3 %}
    <nav class="article-outline" aria-label="Article sections">
      <h2>In this article</h2>
      <ul>{% for item in article.items %}<li><a href="#{{ item.id }}">{{ item.title }}</a></li>{% endfor %}</ul>
    </nav>
    {% endif %}
    <article class="article-body" aria-label="Article">{{ article.body | safe }}</article>
  </div>
  <section class="article-end reading-width"><h2>Questions or corrections?</h2><a class="text-link" href="mailto:{{ site.email }}">Email me ↗</a></section>
</main>
