<div class="exp-tabs-container">
    <div class="exp-tablist" role="tablist" aria-label="Work experience" aria-orientation="vertical">
        {% for job in experience %}<button role="tab" id="tab-{{ job.id }}" class="exp-tab{% if loop.first %} active{% endif %}" aria-selected="{{ 'true' if loop.first else 'false' }}" aria-controls="panel-{{ job.id }}" tabindex="{{ '0' if loop.first else '-1' }}" type="button"><span class="exp-tab-company">{{ job.company }}</span><span class="exp-tab-role">{{ job.shortRole }}</span><span class="exp-tab-time">{{ job.dates }}</span></button>{% endfor %}
    </div>
    <div class="exp-panels">{% for job in experience %}<div role="tabpanel" id="panel-{{ job.id }}" class="exp-panel{% if loop.first %} active{% endif %}" aria-labelledby="tab-{{ job.id }}" tabindex="0"><div class="exp-panel-header"><p class="eyebrow">{{ job.company }} · {{ job.dates }}</p><h3>{{ job.role }}</h3><p class="muted">{{ job.location }}</p></div><p>{{ job.summary }}</p>{% if job.bullets.length %}<ul>{% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}<div class="tags">{% for tag in job.tags %}<span>{{ tag }}</span>{% endfor %}</div>{% if job.photo %}<figure class="exp-photo"><a href="{{ job.photo.src }}" data-view-photo data-photo-caption="{{ job.photo.caption }}" aria-label="Enlarge photo from {{ job.company }}"><img src="{{ job.photo.src }}" alt="{{ job.photo.alt }}" width="655" height="376" loading="lazy"></a><figcaption>{{ job.photo.caption }}</figcaption></figure>{% endif %}</div>{% endfor %}</div>
</div>
