<div class="experience-list">
  {% for job in experience %}
  <article class="experience-entry" id="panel-{{ job.id }}">
    <p class="entry-date">{{ job.dates }}</p>
    <div class="experience-content">
      <header class="experience-entry-heading">
        <h3 id="tab-{{ job.id }}">{{ job.role }}</h3>
        <p class="entry-company">{{ job.company }}</p>
        <p class="muted">{{ job.location }}</p>
      </header>
      <p>{{ job.summary }}</p>
      {% if job.bullets.length %}<ul>{% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
      {% if job.photo and job.id != 'zain' %}<figure class="exp-photo"><a href="{{ job.photo.src }}" data-view-photo data-photo-caption="{{ job.photo.caption }}" aria-label="Enlarge photo from {{ job.company }}"><img src="{{ job.photo.src }}" alt="{{ job.photo.alt }}" {% if job.id == 'freelance-devops' %}width="2584" height="980"{% endif %} loading="lazy"></a><figcaption>{{ job.photo.caption }}</figcaption></figure>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>
