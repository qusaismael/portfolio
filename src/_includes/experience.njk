<div class="experience-list">
  {% for job in experience %}
  <article class="experience-entry" id="job-{{ job.id }}">
    <header class="experience-entry-heading">
      <div><p class="experience-entry-meta">{{ job.company }} · {{ job.dates }}</p><h3>{{ job.role }}</h3><p class="muted">{{ job.location }}</p></div>
    </header>
    <p>{{ job.summary }}</p>
    {% if job.bullets.length %}<ul>{% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
    <div class="tags">{% for tag in job.tags %}<span>{{ tag }}</span>{% endfor %}</div>
    {% if job.photo %}<figure class="exp-photo"><a href="{{ job.photo.src }}" data-view-photo data-photo-caption="{{ job.photo.caption }}" aria-label="Enlarge photo from {{ job.company }}"><img src="{{ job.photo.src }}" alt="{{ job.photo.alt }}" width="655" height="376" loading="lazy"></a><figcaption>{{ job.photo.caption }}</figcaption></figure>{% endif %}
  </article>
  {% endfor %}
</div>
