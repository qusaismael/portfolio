---
layout: base
pagination:
  data: featuredProjects
  size: 1
  alias: project
eleventyComputed:
  title: "{{ project.name }} — Qusai Ismael"
  description: "{{ project.description }}"
  permalink: "/projects/{{ project.slug }}/"
bodyClass: "project-page"
---
<main class="container reading-width" id="main-content">
    <header class="page-heading"><a class="text-link back-link" href="/sites/">← All work</a><p class="eyebrow">{{ project.type }}</p><h1>{{ project.name }}<span class="accent-dot">.</span></h1><p class="page-lede">{{ project.description }}</p><aside class="project-status" aria-label="Project status and limitations"><h2>Status and limits</h2><p>{{ project.status }}</p></aside><div class="tags">{% for tag in project.tags %}<span>{{ tag }}</span>{% endfor %}</div><div class="button-row">{% if project.live %}<a class="button button-primary" href="{{ project.live }}" target="_blank" rel="noopener noreferrer">Try {{ project.name }} ↗</a>{% endif %}{% if project.source %}<a class="button button-secondary" href="{{ project.source }}" target="_blank" rel="noopener noreferrer">Read the source ↗</a>{% endif %}</div></header>
    <div class="project-story"><section><h2>Why I made it</h2><p>{{ project.problem }}</p></section><section><h2>What I built</h2><p>{{ project.built }}</p></section><section><h2>What I learned</h2><p>{{ project.learned }}</p></section></div>
    {% if project.evidenceImage or project.image %}
    {% set evidenceSrc = project.evidenceImage or project.image %}
    {% set evidenceAlt = project.evidenceAlt or project.imageAlt %}
    <figure class="project-evidence"><a href="{{ evidenceSrc }}" data-view-photo data-photo-caption="{{ evidenceAlt }}" aria-label="Enlarge {{ evidenceAlt }}"><img src="{{ evidenceSrc }}" alt="{{ evidenceAlt }}" width="960" height="600" loading="lazy" decoding="async"></a><figcaption>{{ evidenceAlt }}</figcaption></figure>
    {% endif %}
    <section class="project-end"><h2>Questions about {{ project.name }}?</h2><a class="button button-primary" href="mailto:{{ site.email }}?subject={{ project.name | urlencode }}">Email me about {{ project.name }} ↗</a></section>
</main>
