---
layout: base
title: "Résumé — Qusai Ismael"
description: "Qusai Ismael's experience in GRC, privacy, AI security, and software development."
permalink: "/resume/"
bodyClass: "resume-page"
editionStyles: "/css/quiet-about.css"
---
<main class="container" id="main-content">
  <header class="page-heading">
    <h1>{{ site.name }}<span class="accent-dot">.</span></h1>
    <p class="page-lede">Privacy, GRC &amp; AI security · Jordan</p>
    <p class="resume-contact"><a href="mailto:{{ site.email }}">{{ site.email }}</a><a href="{{ site.github }}">github.com/qusaismael ↗</a></p>
    <div class="button-row print-hide"><button type="button" class="button button-primary" data-print>Print / save as PDF</button><a class="text-link" href="/portfolio/">About →</a></div>
  </header>
  <section><h2>Experience</h2>
    <div class="experience-list">
    {% for job in experience %}
      <article class="experience-entry resume-entry">
        <p class="entry-date">{{ job.dates }}</p>
        <div class="experience-content">
          <header class="experience-entry-heading"><h3>{{ job.role }}</h3><p class="entry-company">{{ job.company }}</p><p class="muted">{{ job.location }}</p></header>
          <p>{{ job.summary }}</p>
          {% if job.bullets.length %}<ul>{% for bullet in job.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
        </div>
      </article>
    {% endfor %}
    </div>
  </section>
  <section><h2>Education</h2><div class="education-list"><article><div><h3>The Hashemite University</h3><p>Bachelor's degree in Cyber Security · Excellence</p></div><span class="muted">Oct 2022 – Jun 2026</span></article></div></section>
  <section><h2>Training</h2><div class="education-list"><article><div><h3>Cyber Shield Academy</h3><p>100-hour cybersecurity upskilling program · Score: 92%</p></div><span class="muted">Dec 2025</span></article></div></section>
</main>
